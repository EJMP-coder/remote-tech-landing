# Copia este archivo como .env.deploy y rellena tus datos de Spaceship.
# .env.deploy está en .gitignore — NUNCA lo subas al repositorio.
#
# Dónde encontrar los datos (Spaceship → Web Hosting → Manage → cPanel):
#   - Host:    "Server Name"/"Shared IP" (panel derecho de cPanel) o ftp.remotetech.cc
#   - Usuario: usuario de cPanel (SSH/SFTP) o la cuenta de "FTP Accounts" (FTPS)

# rsync (SSH con clave, recomendado) | sftp | ftps
DEPLOY_METHOD=rsync
DEPLOY_HOST=server.spaceship.example
DEPLOY_PORT=22
DEPLOY_USER=cpanel_usuario
# Solo para sftp / ftps (rsync usa tu clave SSH)
DEPLOY_PASSWORD=
# Ruta remota (relativa al home de la cuenta)
DEPLOY_PATH=public_html
# En FTPS, pon "no" solo si el certificado del servidor no coincide con el host
DEPLOY_VERIFY_CERT=yes

# Si se define, tras subir se ejecuta la verificación automática
SITE_URL=https://remotetech.cc
